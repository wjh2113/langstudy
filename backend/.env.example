# ===== AIapiMgr 网关（推荐）=====
# 填了 GATEWAY_API_KEY 后：生成材料、评分、追问、语音识别、朗读、发音评测都走网关
GATEWAY_URL=https://aiapimgrapi.aidigitcloud.cn
GATEWAY_API_KEY=
GATEWAY_TENANT=langstudy
# 能力名（一般不用改）
GATEWAY_CAP_CHAT=quality-chat
GATEWAY_CAP_FAST=fast-chat
GATEWAY_CAP_SPEECH=speech
GATEWAY_CAP_TTS=tts
GATEWAY_CAP_PRONOUNCE=pronunciation
# 朗读音色（逗号分隔，对话里 A、B 两个角色依次使用）
# 可选：alex / anna / bella / benjamin / charles / claire / david / diana
GATEWAY_TTS_VOICES=FunAudioLLM/CosyVoice2-0.5B:anna,FunAudioLLM/CosyVoice2-0.5B:alex
# 朗读用哪家：edge（微软 Edge 免费语音，默认，不耗积分）或 gateway（网关 CosyVoice，按次扣积分）
TTS_PROVIDER=edge
# 幂等键请求头名：网络重试时带同一个键，避免重复扣积分
GATEWAY_IDEMPOTENCY_HEADER=Idempotency-Key

# ===== 不用网关时的备选 =====
# 任何 OpenAI 兼容接口：DeepSeek / 通义千问 / Kimi / OpenAI
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_JSON_MODE=1
# 服务端语音识别（OpenAI 兼容 /audio/transcriptions）
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=FunAudioLLM/SenseVoiceSmall

# 朗读总开关
TTS_ENABLED=1

# ===== AI 调用 =====
# 单次大模型调用超时（秒）；网络错误和 502/503/504 会带同一个幂等键自动重试 2 次
AI_TIMEOUT_SEC=90
# 每个普通用户每天最多调用大模型几次（出题、评分、追问、对话、笔记、翻译都算），0 = 不限；管理员不受限
AI_DAILY_LIMIT=0
# 同时处理出题/评分/笔记的后台线程数
JOB_WORKERS=4

# ===== 安全 =====
# 部署在 Nginx 等反向代理后面时设为 1，用 X-Forwarded-For 识别真实 IP（否则别开，防伪造）
TRUST_PROXY=0

# ===== 磁盘 =====
# 朗读缓存上限（MB），超出后自动清掉最久没播放的
TTS_CACHE_MAX_MB=500
# 练习录音保留天数，0 = 永久保留（删除练习时录音会一起删掉）
AUDIO_RETENTION_DAYS=90
